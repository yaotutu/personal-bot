# 只在服务端配置模型凭据，禁止放入 EXPO_PUBLIC_*。
# base URL 应是兼容 API 根路径，例如 http://127.0.0.1:8000/v1，不能以 /chat/completions 结尾。
# 留空时服务可启动、可打开客户端，但发送消息会明确提示模型未配置。
PERSONAL_MODEL_BASE_URL=
PERSONAL_MODEL_ID=
PERSONAL_MODEL_API_KEY=

# 模型的真实上下文与输出上限。P1 只使用 Chat Completions 文本流，不开启 reasoning/tools。
PERSONAL_MODEL_CONTEXT_WINDOW=32768
PERSONAL_MODEL_MAX_TOKENS=4096
PERSONAL_RUN_TIMEOUT_MS=120000

HOST=127.0.0.1
PORT=8787
DATA_DIR=.personal-bot
# 本机回环可为空；监听 LAN/公网必须设置。它不是模型 API key。
PERSONAL_ACCESS_KEY=
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
