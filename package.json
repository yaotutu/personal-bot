{
  "name": "pi-muse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node --experimental-strip-types --no-warnings scripts/write-service-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "for dir in tests/unit tests/integration; do set -- \"$dir\"/*.test.ts; test -f \"$1\" || { echo \"No test files found in $dir\" >&2; exit 1; }; done; tsx --test --test-timeout=60000 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "pnpm build && tsx --test --test-concurrency=1 --test-timeout=90000 tests/e2e/*.test.ts",
    "test:live": "tsx tests/live/run.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm --dir web build && git diff --check",
    "dev:mock": "tsx scripts/dev-mock.ts",
    "docs:dev": "vitepress dev docs-site --host 127.0.0.1 --port 4174 --strictPort",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vite preview docs-site --outDir .vitepress/dist --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@hono/node-server": "1.19.9",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.13",
    "playwright-core": "1.62.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.74.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitepress": "1.6.4"
  }
}
